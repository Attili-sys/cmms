{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/canvas-deploy-guard.sh",
            "if": "Bash(*canvas deploy*)",
            "timeout": 30,
            "statusMessage": "Checking deploy branch"
          }
        ]
      }
    ]
  }
}
